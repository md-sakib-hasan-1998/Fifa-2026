ADMIN_PASSWORD=Sakib1998!
ADMIN_COUNTRY=Bangladesh

# ─── Frontend URL (for CORS) ──────────────────────────────
# Set this to your GitHub Pages URL when deployed
# e.g. https://yourusername.github.io
CLIENT_URL=http://localhost:5173

# ─── Sports API ───────────────────────────────────────────
# Get a free key from https://www.api-football.com
SPORTS_API_KEY=your_api_football_key_here
SPORTS_API_BASE=https://v3.football.api-sports.io

# ─── Pi Fetcher Secret ────────────────────────────────────
# The Raspberry Pi uses this key to authenticate when
# posting live score updates to your backend
PI_SECRET=replace_with_a_random_secret_for_your_pi
