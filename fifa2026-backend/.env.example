# ─── Admin Credentials ────────────────────────────────────
# These are used ONLY by the seedAdmin.js script to create
# the one admin account. Change them here if you need to
# reset the admin in future. Never expose this file publicly.
ADMIN_NAME=Admin
ADMIN_EMAIL=sakibhasn85@gmail.com
