# ─── Your backend server URL ──────────────────────────────
# When deployed on Render/Railway, use that URL.
# For local testing, use your computer's local IP.
BACKEND_URL=https://your-backend.onrender.com

# ─── Pi secret ────────────────────────────────────────────
# Must match the PI_SECRET value in your backend's .env
PI_SECRET=replace_with_same_secret_as_backend

# ─── Sports API (api-football.com) ───────────────────────
# Free plan: 100 requests/day. Enough for live match polling.
# Sign up at https://www.api-football.com
SPORTS_API_KEY=your_api_football_key_here
SPORTS_API_BASE=https://v3.football.api-sports.io

# ─── FIFA World Cup 2026 League ID ───────────────────────
# FIFA World Cup league ID on api-football = 1
# This will be confirmed once the tournament starts.
WC_LEAGUE_ID=1
WC_SEASON=2026

# ─── Poll interval (milliseconds) ────────────────────────
# 60000 = every 60 seconds (recommended to stay within free API limits)
# During live matches, reduce to 30000 for faster updates
POLL_INTERVAL_IDLE=120000
POLL_INTERVAL_LIVE=30000
